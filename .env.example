APP_NAME="PMT - PixelMindTrainning"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
# SQLite is the quickest local setup. Create database/database.sqlite first.
DB_CONNECTION=sqlite
# For MariaDB, switch to mysql and uncomment/configure these values:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=pmt_training
# DB_USERNAME=pmt_training
# DB_PASSWORD=
SESSION_DRIVER=file
CACHE_STORE=file
LOG_CHANNEL=single
